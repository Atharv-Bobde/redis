{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug server (LLDB)",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/server",
        "args": ["--dir", "/tmp/redis-files", "--dbfilename", "dump.rdb"],
        "cwd": "${workspaceFolder}",
        "stopOnEntry": false,
        "internalConsoleOptions": "openOnSessionStart",
        "preLaunchTask": "Start Server Script",
      }
    ]
  }